+/* Accepted timestamps independent of VirtIO fences. One timeout=0 ioctl
+ * per poll, without the existing unbounded retry wrapper for waits. */
+static struct oneios_kgsl_drain g_drain = ONEIOS_KGSL_DRAIN_INITIALIZER;
+
+static int
+oneios_wait_accepted(int fd, uint32_t ctx, uint32_t ts, void *unused)
+{
+   (void)unused;
+   struct kgsl_device_waittimestamp_ctxtid wait = {
+      .context_id = ctx, .timestamp = ts, .timeout = 0,
+   };
+   if (!ioctl(fd, IOCTL_KGSL_DEVICE_WAITTIMESTAMP_CTXTID, &wait))
+      return 0;
+   int err = errno;
+   return err == EINTR || err == EAGAIN || err == ETIMEDOUT ? -EAGAIN : -err;
+}
+
+/* 1: suppressed keepalive; 0: accepted; -1: ioctl error. */
+static int
+oneios_tracked_submit(int fd, struct kgsl_gpu_command *cmd, bool keepalive)
+{
+   struct oneios_kgsl_drain_entry *e = NULL;
+   int r = oneios_kgsl_drain_begin(&g_drain, fd, cmd->context_id, keepalive, &e);
+   if (r) {
+      if (r > 0) return 1;
+      errno = -r;
+      return -1;
+   }
+   int ret = kgsl_ioctl(fd, IOCTL_KGSL_GPU_COMMAND, cmd);
+   int saved = errno;
+   oneios_kgsl_drain_finish(&g_drain, e, ret == 0, cmd->timestamp);
+   errno = saved;
+   return ret;
+}
 
