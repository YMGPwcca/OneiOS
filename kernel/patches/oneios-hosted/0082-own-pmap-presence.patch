diff --git a/osfmk/arm64/hosted/hosted_own_presence.h b/osfmk/arm64/hosted/hosted_own_presence.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/hosted/hosted_own_presence.h
@@ -0,0 +1,24 @@
+/* 0082: skip only an own-pmap host unmap proved unnecessary by 0081. */
+#ifndef ONEIOS_HOSTED_OWN_PRESENCE_H
+#define ONEIOS_HOSTED_OWN_PRESENCE_H
+
+#include "hosted_presence.h"
+
+static inline bool
+hosted_own_presence_skip(bool enabled, bool history_enabled,
+    const uint64_t *tags, const uint64_t *bits, uint64_t va,
+    uint64_t size, uint64_t page_size)
+{
+	/* History is collected only when the 0081 boot tunable is on.
+	 * Unknown, malformed and wide ranges always use the original path. */
+	if (!enabled || !history_enabled || !size || !page_size ||
+	    (page_size & (page_size - 1)) != 0 ||
+	    ((va | size) & (page_size - 1)) != 0 ||
+	    size > ~(uint64_t)0 - va) {
+		return false;
+	}
+	return !hosted_presence_maybe(tags, bits, va / page_size,
+	    (va + size) / page_size);
+}
+
+#endif
