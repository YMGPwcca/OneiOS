diff --git a/osfmk/arm64/hosted/hosted_presence.h b/osfmk/arm64/hosted/hosted_presence.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm64/hosted/hosted_presence.h
@@ -0,0 +1,103 @@
+/* 0081: conservative user mapping presence, protected by the pmap's TLB word.
+ * Page numbers, not physical addresses. A slot is empty, exact (tag+bitmap),
+ * or unknown after a collision. Unknown is sticky until a complete accepted
+ * address-space unmap. False positives cost work; false negatives are forbidden.
+ * This header is also compiled by the host tests. No allocation on the fault
+ * or invalidation path. The caller marks BEFORE publishing any task_map, and
+ * forgets only after task_unmap has accepted the order (including deferred
+ * orders protected by the existing release protocol).
+ */
+#ifndef ONEIOS_HOSTED_PRESENCE_H
+#define ONEIOS_HOSTED_PRESENCE_H
+
+#define HOSTED_PRESENCE_SETS 128u
+#define HOSTED_PRESENCE_UNKNOWN (~(uint64_t)0)
+#define HOSTED_PRESENCE_MAX_BLOCKS 64u
+
+static inline unsigned
+hosted_presence_index(uint64_t block)
+{
+	return (unsigned)((block ^ (block >> 7) ^ (block >> 14) ^
+	    (block >> 21) ^ (block >> 28)) & (HOSTED_PRESENCE_SETS - 1));
+}
+
+static inline void
+hosted_presence_mark(uint64_t *tags, uint64_t *bits, uint64_t page)
+{
+	uint64_t block = page >> 6, tag = block + 1;
+	unsigned i = hosted_presence_index(block);
+	if (tags[i] == HOSTED_PRESENCE_UNKNOWN) {
+		return;
+	}
+	if (tags[i] != 0 && tags[i] != tag) {
+		tags[i] = HOSTED_PRESENCE_UNKNOWN;
+		bits[i] = 0;
+		return;
+	}
+	tags[i] = tag;
+	bits[i] |= 1ULL << (page & 63);
+}
+
+/* One nonempty intersection of [first,end) with the current 64-page block. */
+static inline uint64_t
+hosted_presence_mask(uint64_t first, uint64_t end)
+{
+	unsigned off = (unsigned)(first & 63);
+	uint64_t len = end - first;
+	return len == 64 ? ~(uint64_t)0 : ((1ULL << len) - 1) << off;
+}
+
+static inline bool
+hosted_presence_bounded(uint64_t first, uint64_t end)
+{
+	return first < end &&
+	    ((end - 1) >> 6) - (first >> 6) < HOSTED_PRESENCE_MAX_BLOCKS;
+}
+
+/* A false result proves no possible map in the range; unknown/large => true. */
+static inline bool
+hosted_presence_maybe(const uint64_t *tags, const uint64_t *bits,
+    uint64_t first, uint64_t end)
+{
+	if (!hosted_presence_bounded(first, end)) {
+		return true;
+	}
+	while (first < end) {
+		uint64_t block = first >> 6;
+		uint64_t n = 64 - (first & 63);
+		uint64_t next = end - first < n ? end : first + n;
+		unsigned i = hosted_presence_index(block);
+		if (tags[i] == HOSTED_PRESENCE_UNKNOWN ||
+		    (tags[i] == block + 1 &&
+		    (bits[i] & hosted_presence_mask(first, next)) != 0)) {
+			return true;
+		}
+		first = next;
+	}
+	return false;
+}
+
+/* A successful unmap proves exact bits absent, but cannot resolve a collision.
+ * Large non-full unmaps deliberately retain history rather than walk it.
+ */
+static inline void
+hosted_presence_forget(uint64_t *tags, uint64_t *bits, uint64_t first, uint64_t end)
+{
+	if (!hosted_presence_bounded(first, end)) {
+		return;
+	}
+	while (first < end) {
+		uint64_t block = first >> 6;
+		uint64_t n = 64 - (first & 63);
+		uint64_t next = end - first < n ? end : first + n;
+		unsigned i = hosted_presence_index(block);
+		if (tags[i] == block + 1) {
+			bits[i] &= ~hosted_presence_mask(first, next);
+			if (bits[i] == 0) {
+				tags[i] = 0;
+			}
+		}
+		first = next;
+	}
+}
+#endif
